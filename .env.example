# Copy to .env.local for development. Both values are public by design: the anon/publishable
# key only grants what the Row Level Security policies allow. Never use the service_role key here.
#
# Local stack (`supabase start` prints these):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=sb_publishable_...
#
# Hosted project: Supabase dashboard -> Project Settings -> API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
